# Hasło do logowania w aplikacji (wymagane w produkcji)
APP_PASSWORD=
# Losowy, długi ciąg do podpisywania sesji (wymagane w produkcji)
AUTH_SECRET=
# Postgres (np. Neon z Vercel Marketplace). Bez tej zmiennej lokalnie używana jest wbudowana baza PGlite w katalogu .data/
DATABASE_URL=
# Etap 2 (tryb AI) – na razie nieużywane
ANTHROPIC_API_KEY=
# Automatyczna synchronizacja integracji API (Vercel Cron) – dowolny długi losowy ciąg
CRON_SECRET=
